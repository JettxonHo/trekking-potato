{
  "name": "trekking-potato",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "bootstrap": "corepack npm@10.9.2 ci --prefix taro-app && corepack npm@10.9.2 ci --prefix cloudfunctions/getAdvice && corepack npm@10.9.2 ci --prefix cloudfunctions/history",
    "build:weapp": "npm --prefix taro-app run build:weapp",
    "lint": "eslint .",
    "test": "npm run test:route && npm run test:weather && npm run test:unit",
    "test:integration": "node scripts/e2e-local.js",
    "test:route": "node scripts/route-type-contract-test.js",
    "test:weather": "node scripts/weather-contract-test.js",
    "test:unit": "node scripts/unit-test.js",
    "typecheck": "tsc --project tsconfig.quality.json"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "24.x",
    "npm": "10.9.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "18.3.12",
    "eslint": "9.39.1",
    "eslint-plugin-react": "7.37.5",
    "globals": "15.15.0",
    "typescript": "5.9.3"
  }
}
